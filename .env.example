# FinSight — Environment Configuration
# Copy this file to .env and fill in your API keys.

# ──────────────────────────────────────────────────────────────
# Groq API (Primary LLM) — https://console.groq.com
# ──────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────────────────────────────
# Google AI Studio (Embeddings + Fallback LLM) — https://aistudio.google.com
# ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ──────────────────────────────────────────────────────────────
# Qdrant Cloud (Vector DB) — https://cloud.qdrant.io
# ──────────────────────────────────────────────────────────────
QDRANT_URL=your_qdrant_cluster_url_here
QDRANT_API_KEY=your_qdrant_api_key_here

# ──────────────────────────────────────────────────────────────
# Langfuse (Observability) — https://cloud.langfuse.com
# ──────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ──────────────────────────────────────────────────────────────
# Model Configuration
# ──────────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# ──────────────────────────────────────────────────────────────
# Qdrant Collection
# ──────────────────────────────────────────────────────────────
QDRANT_COLLECTION_NAME=finsight_docs
